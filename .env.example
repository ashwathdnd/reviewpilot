# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n... paste PEM content here or a path to a .pem file ...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# SQLite database (default is fine for a single instance)
DATABASE_URL=sqlite:///./reviewpilot.db

# Review tuning
CONFIDENCE_THRESHOLD=0.7
MAX_FINDINGS=5
MAX_FINDINGS_PER_FILE=2
MAX_FILES=20
MAX_CHARS=100000

# Timeouts and retries
GITHUB_REQUEST_TIMEOUT=30
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BACKOFF=1.0
OPENAI_TIMEOUT=60

# Server
PORT=8000
LOG_LEVEL=info
